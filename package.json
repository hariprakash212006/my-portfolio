{
  "name": "portfolio-admin-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node scripts/seed.mjs",
    "use:postgres": "node -e \"const fs = require('fs'); fs.copyFileSync('prisma/schema.postgresql.prisma', 'prisma/schema.prisma'); console.log('Switched Prisma schema to PostgreSQL');\"",
    "use:sqlite": "node -e \"const fs = require('fs'); fs.copyFileSync('prisma/schema.sqlite.prisma', 'prisma/schema.prisma'); console.log('Switched Prisma schema to SQLite');\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next-auth": "5.0.0-beta.25",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "zod": "^3.24.2",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.10.0",
    "lucide-react": "^0.475.0",
    "framer-motion": "^12.4.7",
    "next-themes": "^0.4.4",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "sonner": "^2.0.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-label": "^2.1.2",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "resend": "^4.1.2",
    "cloudinary": "^2.5.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7"
  }
}

# Database (PostgreSQL - Neon / Supabase / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="portfolio-super-secret-key-change-me-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary Media Storage (Optional: Local fallback supported for development)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend Email (Optional: Falls back to console log in development)
RESEND_API_KEY=""
CONTACT_NOTIFICATION_EMAIL="owner@example.com"

# Public Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
